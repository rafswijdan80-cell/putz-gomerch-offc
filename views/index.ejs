                <span class="flex items-center gap-1"><i data-lucide="shield-check" class="w-3.5 h-3.5 text-emerald-600"></i> Secure API</span>
                <span class="flex items-center gap-1"><i data-lucide="zap" class="w-3.5 h-3.5 text-amber-500"></i> High Performance</span>
            </div>
        </div>
    </footer>

    <div class="toast-container fixed bottom-7 left-7 z-[9999] pointer-events-none">
        <div id="toast" class="toast flex items-center gap-3 opacity-0 pointer-events-auto" style="transform:translateY(24px) scale(.95);transition:all .3s cubic-bezier(.22,.61,.36,1)">
            <span class="toast-icon">📋</span>
            <span id="toast-msg">Copied!</span>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            lucide.createIcons();
        });

        const BASE_URL = window.location.origin;

        function getVal(id) {
            const el = document.getElementById(id);
            return el ? el.value.trim() : '';
        }

        // ── Terminal helper ──
        function setTerm(id, html, state) {
            const el = document.getElementById(id);
            el.className = 'p-5 sm:p-6 h-full overflow-auto custom-scrollbar state-' + (state || 'idle');
            el.innerHTML = html;
            el.scrollTop = el.scrollHeight;
        }

        // ── Toast ──
        let toastTimer;
        function showToast(message, icon = '📋') {
            const toast = document.getElementById('toast');
            const msg   = document.getElementById('toast-msg');
            const ico   = toast.querySelector('.toast-icon');
            ico.textContent = icon;
            msg.textContent = message;
            toast.classList.add('show');
            toast.style.opacity = '1';
            toast.style.transform = 'translateY(0) scale(1)';
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(24px) scale(.95)';
            }, 2400);
        }

        // ── Copy URL ──
        function copyEndpointWithParams(endpointKey, path, paramNames) {
            const params = {};
            let filledCount = 0;
            paramNames.forEach(pName => {
                const val = getVal('param-' + endpointKey + '-' + pName);
                params[pName] = val;
                if (val !== '') filledCount++;
            });
            const query   = new URLSearchParams(params).toString();
            const fullUrl = query ? BASE_URL + path + '?' + query : BASE_URL + path;
            navigator.clipboard.writeText(fullUrl).then(() => {
                const btn = document.getElementById('copy-btn-' + endpointKey);
                if (btn) { btn.classList.add('copied'); setTimeout(() => btn.classList.remove('copied'), 1500); }
                showToast('URL disalin' + (filledCount > 0 ? ' (+ ' + filledCount + ' param)' : ''), '📋');
            });
        }

        // ── Copy result ──
        function copyResult(preId) {
            const pre = document.getElementById(preId);
            if (!pre) return;
            navigator.clipboard.writeText(pre.innerText || pre.textContent).then(() => {
                const btn = pre.closest('.api-terminal').querySelector('.copy-result-btn');
                if (btn) { btn.classList.add('copied'); setTimeout(() => btn.classList.remove('copied'), 1500); }
                showToast('Result disalin', '📋');
            });
        }

        // ── Run API test ──
        async function runApiTest(endpoint, params, resultElementId) {
            const clean = Object.fromEntries(Object.entries(params).filter(([,v]) => v !== '' && v != null));
            const q = new URLSearchParams(clean).toString();
            const fullPath = q ? endpoint + '?' + q : endpoint;

            setTerm(resultElementId,
                'root@xenoffc# GET ' + fullPath + '\n\n> Connecting...\n> Sending request...',
                'load'
            );

            try {
                const t0  = Date.now();
                const res = await fetch(q ? endpoint + '?' + q : endpoint);
                const elapsed = Date.now() - t0;
                const data = await res.json();
                const ts = new Date().toLocaleString('id-ID', { hour12: false });
                const ok = res.ok;
                const out =
                    'root@xenoffc# GET ' + fullPath + '\n\n' +
                    '> [' + ts + ']\n' +
                    '> HTTP/1.1 ' + res.status + ' ' + (ok ? 'OK' : 'ERROR') + '\n' +
                    '> X-Response-Time: ' + elapsed + 'ms\n' +
                    '> Content-Type: application/json\n\n' +
                    JSON.stringify(data, null, 2) +
                    '\n\nroot@xenoffc# <span class="term-cursor"></span>';
                setTerm(resultElementId, out, ok ? 'ok' : 'err');
            } catch (e) {
                const ts = new Date().toLocaleString('id-ID', { hour12: false });
                setTerm(resultElementId,
                    'root@xenoffc# GET ' + fullPath + '\n\n' +
                    '> [' + ts + ']\n' +
                    '> FATAL: Network / CORS Error\n' +
                    '> ' + e.message + '\n' +
                    '> Pastikan backend berjalan dan CORS diizinkan.\n\n' +
                    'root@xenoffc# <span class="term-cursor"></span>',
                    'err'
                );
            }
        }
    </script>
